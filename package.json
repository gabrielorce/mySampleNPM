  "scripts": {
    "start": "run NODE_ENV=development concurrently -k 'nodemon --exec babel-node -- src/start.js' 'react-scripts start'",
    "start:inspect": "run NODE_ENV=development concurrently -k 'nodemon --inspect --exec babel-node -- src/start.js' 'react-scripts start'",
    "server": "run NODE_ENV=production node lib/start.js",
    "build": "run scripts/build",
    "build-babel": "run scripts/build-babel",
    "test": "NODE_ENV=development npm run lint && npm run test:unit",
    "test:unit": "run NODE_ENV=test jest",
    "lint": "eslint src/. --ext .js,.jsx",
    "lint:fix": "eslint src/. --ext .js,.jsx --fix",
    "prepublishOnly": "run NODE_ENV=production scripts/build-babel",
    "postpublish": "rimraf lib",
    "prepush": "npm test",
    "start:server": "NODE_ENV=development nodemon --exec babel-node -- src/start.js",
    "start:server:inspect": "NODE_ENV=development nodemon --inspect --exec babel-node -- src/start.js",
    "start:react": "react-scripts start"
  },
  "files": [
    "lib",
    "build"
  ],
  "higher-standard": {
    "global": [
      "jest",
      "it",
      "describe"
    ]
  },
  "jest": {
    "rootDir": "./src",
    "setupFilesAfterEnv": [
      "../test/setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!auth0-js).+\\.js$"
    ],
    "testURL": "http://localhost/"
  },
  "proxy": "http://localhost:5000",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "nodemonConfig": {
    "ignore": [
      "clone_logs/*"
    ]
  }
}
